#!/usr/bin/env bash
set -eo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
STOW_TARGET="$HOME"
SELECTED_CLI=""
PACKAGES=()
BACKUP_DIR=""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[info]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
error() { echo -e "${RED}[error]${NC} $1"; }

check_deps() {
  local missing=()

  if ! command -v gum &>/dev/null; then
    missing+=("gum")
  fi

  if ! command -v stow &>/dev/null; then
    missing+=("stow")
  fi

  if [[ ${#missing[@]} -eq 0 ]]; then
    info "All dependencies are installed."
    return 0
  fi

  warn "Missing dependencies: ${missing[*]}"

  if ! command -v brew &>/dev/null; then
    error "Homebrew is required to install dependencies: https://brew.sh"
    exit 1
  fi

  echo ""
  read -rp "Install missing dependencies with brew? [y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    for dep in "${missing[@]}"; do
      info "Installing $dep..."
      brew install "$dep"
    done
  else
    error "Cannot continue without: ${missing[*]}"
    exit 1
  fi
}

# List dirs managed by stow (from repo content)
managed_dirs() {
  local config_dir="$REPO_DIR/$SELECTED_CLI/.$SELECTED_CLI"
  find "$config_dir" -maxdepth 1 -mindepth 1 -type d -exec basename {} \;
}

get_config_dir() {
  echo "$STOW_TARGET/.$SELECTED_CLI"
}

backup_existing() {
  local config_dir=$(get_config_dir)
  local has_real_dirs=false

  while read -r dir; do
    [[ -d "$config_dir/$dir" && ! -L "$config_dir/$dir" ]] && has_real_dirs=true && break
  done < <(managed_dirs)

  if [[ "$has_real_dirs" == false ]]; then
    return 0
  fi

  if [[ -d "$BACKUP_DIR" ]]; then
    error "A backup already exists at $BACKUP_DIR"
    error "Please remove or rename it before installing: rm -rf $BACKUP_DIR"
    exit 1
  fi

  warn "Existing config found in ~/.$SELECTED_CLI/"

  if gum confirm "Back up managed dirs to ~/.$SELECTED_CLI.bak ?"; then
    mkdir -p "$BACKUP_DIR"
    while read -r dir; do
      [[ -d "$config_dir/$dir" && ! -L "$config_dir/$dir" ]] && cp -r "$config_dir/$dir" "$BACKUP_DIR/$dir"
    done < <(managed_dirs)
    info "Backup saved to $BACKUP_DIR"
  else
    warn "Proceeding without backup."
  fi

  # Remove real dirs so stow can do clean tree folding
  while read -r dir; do
    [[ -d "$config_dir/$dir" && ! -L "$config_dir/$dir" ]] && rm -rf "$config_dir/$dir"
  done < <(managed_dirs)
}

# Copy back user files from backup that don't exist in stowed dirs
restore_user_files() {
  [[ ! -d "$BACKUP_DIR" ]] && return 0

  local config_dir=$(get_config_dir)
  local count=0

  for backup_dir in "$BACKUP_DIR"/*/; do
    [[ ! -d "$backup_dir" ]] && continue
    local dirname
    dirname=$(basename "$backup_dir")
    local target_dir="$config_dir/$dirname"

    for file in "$backup_dir"/*; do
      [[ ! -f "$file" ]] && continue
      local filename
      filename=$(basename "$file")
      if [[ ! -e "$target_dir/$filename" ]]; then
        cp "$file" "$target_dir/$filename"
        count=$((count + 1))
      fi
    done
  done

  if [[ $count -gt 0 ]]; then
    info "Restored $count user file(s) from backup"
  fi
}

do_install() {
  backup_existing

  info "Installing $SELECTED_CLI skills..."
  for pkg in "${PACKAGES[@]}"; do
    info "Stowing $pkg..."
    stow -t "$STOW_TARGET" -d "$REPO_DIR" -D "$pkg"
    stow -t "$STOW_TARGET" -d "$REPO_DIR" "$pkg"
  done

  restore_user_files

  info "Done! Skills installed to ~/.$SELECTED_CLI/"
}

do_uninstall() {
  info "Uninstalling $SELECTED_CLI skills..."
  for pkg in "${PACKAGES[@]}"; do
    info "Unstowing $pkg..."
    stow -t "$STOW_TARGET" -d "$REPO_DIR" -D "$pkg"
  done

  if [[ -d "$BACKUP_DIR" ]]; then
    info "Restoring backup from $BACKUP_DIR..."
    local config_dir=$(get_config_dir)
    cp -r "$BACKUP_DIR"/* "$config_dir/"
    rm -rf "$BACKUP_DIR"
    info "Backup restored and removed."
  fi

  info "Done! Skills removed."
}

main() {
  echo "=== Skills Manager for Claude Code & OpenCode ==="
  echo ""

  check_deps

  # Select CLI
  SELECTED_CLI=$(gum choose \
    --header "Select your CLI:" \
    "claude" \
    "opencode") || true

  [[ -z "$SELECTED_CLI" ]] && echo "No CLI selected." && exit 0

  # Set package and backup directory based on selection
  PACKAGES=("$SELECTED_CLI")
  BACKUP_DIR="$STOW_TARGET/.$SELECTED_CLI.bak"

  info "Selected: $SELECTED_CLI"
  echo ""

  # Select action
  local action
  action=$(gum choose \
    --header "Select an action:" \
    "Install skills" \
    "Uninstall skills") || true

  [[ -z "$action" ]] && echo "No action selected." && exit 0

  case "$action" in
    "Install skills")
      do_install
      ;;
    "Uninstall skills")
      do_uninstall
      ;;
  esac
}

main
