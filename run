#!/usr/bin/env bash
set -eo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET="$HOME"
CLI=""

# Deps that remain visible in the selector even when referenced by agents.
# Everything else that's an agent dep gets hidden (installed via its agent).
STANDALONE="caveman coding-standards security-review docker-patterns tdd-workflow verification-loop deep-research"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[info]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
error() { echo -e "${RED}[error]${NC} $1"; exit 1; }

check_gum() {
  command -v gum &>/dev/null && return
  if command -v brew &>/dev/null; then
    read -rp "gum not found. Install with brew? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] && brew install gum || error "gum required"
  else
    error "gum required — install from https://github.com/charmbracelet/gum"
  fi
}

# List all installable items as "category/name" lines
list_all() {
  local src="$REPO_DIR/$CLI/.$CLI"
  for dir in "$src"/*/; do
    local category=$(basename "$dir")
    [[ "$category" == "node_modules" ]] && continue
    if [[ "$category" == "skills" ]]; then
      for skill in "$dir"/*/; do
        [[ -d "$skill" ]] && echo "skills/$(basename "$skill")"
      done
    else
      for f in "$dir"/*.md; do
        [[ -f "$f" ]] && echo "$category/$(basename "$f" .md)"
      done
    fi
  done | sort
}

# Extract dependencies from an agent's Bootstrap section
# Returns "category/name" lines (commands/* for claude, skills/* for opencode)
deps_of() {
  local item="$1" file
  [[ "$item" == agents/* ]] || return
  file="$REPO_DIR/$CLI/.$CLI/$item.md"
  [[ -f "$file" ]] || return
  if [[ "$CLI" == "claude" ]]; then
    grep -o '~/\.claude/commands/[^`]*\.md' "$file" 2>/dev/null \
      | sed 's|~/.claude/commands/||; s|\.md$||; s|^|commands/|'
  else
    grep -o '~/\.opencode/skills/[^/]*/SKILL\.md' "$file" 2>/dev/null \
      | sed 's|~/.opencode/skills/||; s|/SKILL\.md$||; s|^|skills/|'
  fi
}

# Collect all deps from all agents (deduplicated)
all_agent_deps() {
  local src="$REPO_DIR/$CLI/.$CLI/agents"
  [[ -d "$src" ]] || return
  for f in "$src"/*.md; do
    [[ -f "$f" ]] && deps_of "agents/$(basename "$f" .md)"
  done | sort -u
}

# Is this item name in the STANDALONE list?
is_standalone() {
  local name="${1##*/}" # "commands/caveman" → "caveman"
  [[ " $STANDALONE " == *" $name "* ]]
}

# List items visible in the selector:
# - All agents
# - Orphan commands/skills (not a dep of any agent, by name)
# - Standalone deps (in STANDALONE list even if they're agent deps)
# - For opencode: deduplicate commands/X + skills/X pairs (show commands/ only)
list_visible() {
  local all_dep_names
  all_dep_names=$(all_agent_deps | sed 's|.*/||' | sort -u)
  list_all | while read -r item; do
    local name="${item##*/}"
    if [[ "$item" == agents/* ]]; then
      echo "$item"
    elif [[ "$CLI" == "opencode" && "$item" == skills/* ]] \
      && [[ -f "$REPO_DIR/$CLI/.$CLI/commands/${name}.md" ]]; then
      # Skip skills/ when matching commands/ exists (dedup — commands/ wins)
      continue
    elif is_standalone "$item"; then
      echo "$item"
    elif [[ -z "$all_dep_names" ]] || ! echo "$all_dep_names" | grep -qx "$name"; then
      echo "$item"
    fi
  done
}

# Extract short description from frontmatter (first sentence, max 60 chars)
desc_of() {
  local item="$1" file
  if [[ "$item" == skills/* ]]; then
    file="$REPO_DIR/$CLI/.$CLI/$item/SKILL.md"
  else
    file="$REPO_DIR/$CLI/.$CLI/$item.md"
  fi
  [[ -f "$file" ]] || return
  awk '/^---$/{n++; next} n==1 && /^description:/{
    sub(/^description: */, "")
    sub(/\. .*/, "")
    if (length > 120) { $0 = substr($0, 1, 117) "..." }
    print; exit
  }' "$file"
}

# List items with descriptions for display: "category/name — desc [+N deps]"
list_display() {
  local items="$1"
  while read -r item; do
    local desc ndeps suffix=""
    desc=$(desc_of "$item")
    if [[ "$item" == agents/* ]]; then
      ndeps=$(deps_of "$item" | wc -l | tr -d ' ')
      [[ "$ndeps" -gt 0 ]] && suffix=" [+${ndeps} deps]"
    fi
    if [[ -n "$desc" ]]; then
      echo "$item — ${desc}${suffix}"
    else
      echo "$item${suffix}"
    fi
  done <<< "$items"
}

# Strip description from display line: "category/name — desc" → "category/name"
strip_desc() {
  sed 's/ — .*//'
}

# Source path for an item
src_of() {
  local item="$1"
  if [[ "$item" == skills/* ]]; then
    echo "$REPO_DIR/$CLI/.$CLI/$item"
  else
    echo "$REPO_DIR/$CLI/.$CLI/$item.md"
  fi
}

# Target path for an item
dest_of() {
  local item="$1"
  if [[ "$item" == skills/* ]]; then
    echo "$TARGET/.$CLI/$item"
  else
    echo "$TARGET/.$CLI/$item.md"
  fi
}

# Is this symlink ours?
is_ours() {
  [[ -L "$1" ]] && [[ "$(readlink "$1")" == "$REPO_DIR"/* ]]
}

do_install() {
  local items selected count=0
  items=$(list_visible)
  [[ -z "$items" ]] && error "No items found for $CLI"

  local display
  display=$(list_display "$items")

  # Pre-select already installed items
  local preselected=()
  while read -r item; do
    is_ours "$(dest_of "$item")" && preselected+=("$item")
  done <<< "$items"

  # Build pre-selected display lines
  local preselected_display=()
  if [[ ${#preselected[@]} -gt 0 ]]; then
    for p in "${preselected[@]}"; do
      local line
      line=$(echo "$display" | grep "^${p}\b")
      [[ -n "$line" ]] && preselected_display+=("$line")
    done
  fi

  if [[ ${#preselected_display[@]} -gt 0 ]]; then
    selected=$(echo "$display" | gum filter --no-limit \
      --header "Select items to install:" \
      --selected "$(IFS=,; echo "${preselected_display[*]}")") || true
  else
    selected=$(echo "$display" | gum filter --no-limit \
      --header "Select items to install:") || true
  fi

  [[ -z "$selected" ]] && warn "Nothing selected." && return

  # Resolve agent dependencies: expand selected items to include deps
  # For opencode: also resolve commands/X → skills/X pairs
  local resolved=()
  while read -r line; do
    local item
    item=$(echo "$line" | strip_desc)
    resolved+=("$item")
    if [[ "$item" == agents/* ]]; then
      while read -r dep; do
        [[ -n "$dep" ]] && resolved+=("$dep")
      done < <(deps_of "$item")
    elif [[ "$CLI" == "opencode" && "$item" == commands/* ]]; then
      local name="${item##*/}"
      [[ -d "$REPO_DIR/$CLI/.$CLI/skills/$name" ]] && resolved+=("skills/$name")
    fi
  done <<< "$selected"

  # Deduplicate while preserving order
  local seen="" unique=()
  for item in "${resolved[@]}"; do
    if [[ "$seen" != *"|$item|"* ]]; then
      seen="${seen}|$item|"
      unique+=("$item")
    fi
  done

  local count=0 deps_count=0
  for item in "${unique[@]}"; do
    local src=$(src_of "$item") dest=$(dest_of "$item")
    is_ours "$dest" && continue
    if [[ -e "$dest" || -L "$dest" ]]; then
      warn "Skip $item — already exists (not ours)"
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    ln -s "$src" "$dest"
    count=$((count + 1))
  done

  info "Linked $count new item(s) to ~/.$CLI/"
}

do_uninstall() {
  local items installed=() count=0
  items=$(list_all)

  while read -r item; do
    is_ours "$(dest_of "$item")" && installed+=("$item")
  done <<< "$items"

  [[ ${#installed[@]} -eq 0 ]] && warn "Nothing installed." && return

  local installed_list
  installed_list=$(printf '%s\n' "${installed[@]}")
  local display
  display=$(list_display "$installed_list")

  local selected
  selected=$(echo "$display" | gum filter --no-limit \
    --header "Select items to uninstall:" \
    --selected "$(echo "$display" | tr '\n' ',')") || true

  [[ -z "$selected" ]] && warn "Nothing selected." && return

  while read -r line; do
    local item
    item=$(echo "$line" | strip_desc)
    local dest=$(dest_of "$item")
    is_ours "$dest" && rm "$dest" && count=$((count + 1))
  done <<< "$selected"

  info "Removed $count item(s) from ~/.$CLI/"
}

do_install_all() {
  local items count=0 skipped=0
  items=$(list_all)
  [[ -z "$items" ]] && error "No items found for $CLI"

  while read -r item; do
    local src=$(src_of "$item") dest=$(dest_of "$item")
    is_ours "$dest" && continue
    if [[ -e "$dest" || -L "$dest" ]]; then
      warn "Skip $item — already exists (not ours)"
      skipped=$((skipped + 1))
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    ln -s "$src" "$dest"
    count=$((count + 1))
  done <<< "$items"

  info "Linked $count new item(s) to ~/.$CLI/"
  [[ $skipped -gt 0 ]] && warn "Skipped $skipped item(s) — already exist (not ours)"
  return 0
}

main() {
  echo "=== Skills Manager ==="
  echo ""
  check_gum

  CLI=$(gum choose --header "Select CLI:" "claude" "opencode") || true
  [[ -z "$CLI" ]] && exit 0

  local action
  action=$(gum choose --header "Action:" "Install" "Install all" "Uninstall") || true
  [[ -z "$action" ]] && exit 0

  case "$action" in
    Install)      do_install ;;
    "Install all") do_install_all ;;
    Uninstall)    do_uninstall ;;
  esac
}

main
