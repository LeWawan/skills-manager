#!/usr/bin/env bash
set -eo pipefail

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET="$HOME"
CLI=""

# Deps that remain visible in the selector even when referenced by agents.
STANDALONE="caveman coding-standards security-review docker-patterns tdd-workflow verification-loop deep-research"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[info]${NC} $1"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $1"; }
error() { echo -e "${RED}[error]${NC} $1"; return 1; }

check_gum() {
  command -v gum &>/dev/null && return
  if command -v brew &>/dev/null; then
    read -rp "gum not found. Install with brew? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] && brew install gum || error "gum required"
  else
    error "gum required — install from https://github.com/charmbracelet/gum"
  fi
}

# ---------------------------------------------------------------------------
# Pure functions — no gum, no side effects beyond stdout
# ---------------------------------------------------------------------------

# List all installable items as "category/name" lines
list_all() {
  local src="$REPO_DIR/$CLI/.$CLI"
  for dir in "$src"/*/; do
    local category
    category=$(basename "$dir")
    [[ "$category" == "node_modules" ]] && continue
    if [[ "$category" == "skills" ]]; then
      for skill in "$dir"/*/; do
        if [[ -d "$skill" ]]; then echo "skills/$(basename "$skill")"; fi
      done
    else
      for f in "$dir"/*.md; do
        if [[ -f "$f" ]]; then echo "$category/$(basename "$f" .md)"; fi
      done
    fi
  done | sort
}

# Source path for an item
src_of() {
  local item="$1"
  if [[ "$item" == skills/* ]]; then
    echo "$REPO_DIR/$CLI/.$CLI/$item"
  else
    echo "$REPO_DIR/$CLI/.$CLI/$item.md"
  fi
}

# Target path for an item
dest_of() {
  local item="$1"
  if [[ "$item" == skills/* ]]; then
    echo "$TARGET/.$CLI/$item"
  else
    echo "$TARGET/.$CLI/$item.md"
  fi
}

# Is this symlink ours?
is_ours() {
  [[ -L "$1" ]] && [[ "$(readlink "$1")" == "$REPO_DIR"/* ]]
}

# Extract dependencies from an agent's Bootstrap section
deps_of() {
  local item="$1" file
  [[ "$item" == agents/* ]] || return 0
  file="$REPO_DIR/$CLI/.$CLI/$item.md"
  [[ -f "$file" ]] || return 0
  if [[ "$CLI" == "claude" ]]; then
    grep -o '~/\.claude/commands/[^`]*\.md' "$file" 2>/dev/null \
      | sed 's|~/.claude/commands/||; s|\.md$||; s|^|commands/|' || true
  else
    grep -o '~/\.opencode/skills/[^/]*/SKILL\.md' "$file" 2>/dev/null \
      | sed 's|~/.opencode/skills/||; s|/SKILL\.md$||; s|^|skills/|' || true
  fi
}

# Collect all deps from all agents (deduplicated)
all_agent_deps() {
  local src="$REPO_DIR/$CLI/.$CLI/agents"
  [[ -d "$src" ]] || return 0
  for f in "$src"/*.md; do
    if [[ -f "$f" ]]; then deps_of "agents/$(basename "$f" .md)"; fi
  done | sort -u
}

# Is this item name in the STANDALONE list?
is_standalone() {
  local name="${1##*/}"
  [[ " $STANDALONE " == *" $name "* ]]
}

# List items visible in the selector
list_visible() {
  local all_dep_names
  all_dep_names=$(all_agent_deps | sed 's|.*/||' | sort -u)
  list_all | while read -r item; do
    local name="${item##*/}"
    if [[ "$item" == agents/* ]]; then
      echo "$item"
    elif [[ "$CLI" == "opencode" && "$item" == skills/* ]] \
      && [[ -f "$REPO_DIR/$CLI/.$CLI/commands/${name}.md" ]]; then
      continue
    elif is_standalone "$item"; then
      echo "$item"
    elif [[ -z "$all_dep_names" ]] || ! echo "$all_dep_names" | grep -qx "$name"; then
      echo "$item"
    fi
  done
}

# Extract short description from frontmatter (first sentence, max 120 chars)
desc_of() {
  local item="$1" file
  if [[ "$item" == skills/* ]]; then
    file="$REPO_DIR/$CLI/.$CLI/$item/SKILL.md"
  else
    file="$REPO_DIR/$CLI/.$CLI/$item.md"
  fi
  [[ -f "$file" ]] || return 0
  awk '/^---$/{n++; next} n==1 && /^description:/{
    sub(/^description: */, "")
    gsub(/^["'\''"]|["'\''"]$/, "")
    sub(/\. .*/, "")
    gsub(/,/, ";")
    if (length > 120) { $0 = substr($0, 1, 117) "..." }
    print; exit
  }' "$file"
}

# List items with descriptions for display
list_display() {
  local items="$1"
  while read -r item; do
    echo "$item"
  done <<< "$items"
}

# Strip description from display line
strip_desc() {
  sed 's/ — .*//'
}

# ---------------------------------------------------------------------------
# Overridable confirm — tests override this
# ---------------------------------------------------------------------------
confirm_fn() {
  gum confirm "$1"
}

# ---------------------------------------------------------------------------
# Content comparison (files or dirs)
# ---------------------------------------------------------------------------
content_matches() {
  local src="$1" dest="$2"
  if [[ -d "$src" ]]; then
    diff -rq "$src" "$dest" &>/dev/null
  else
    diff -q "$src" "$dest" &>/dev/null
  fi
}

# ---------------------------------------------------------------------------
# Migrate: replace existing non-ours file with symlink
# Returns: 0 = migrated, 1 = user refused, 2 = nothing to do
# Callers MUST use: migrate_item "$x" || rc=$?
# ---------------------------------------------------------------------------
migrate_item() {
  local item="$1"
  local src dest
  src=$(src_of "$item")
  dest=$(dest_of "$item")
  [[ -e "$dest" || -L "$dest" ]] || return 2
  is_ours "$dest" && return 2

  local cmp_dest="$dest"
  if [[ -L "$dest" ]]; then cmp_dest=$(readlink "$dest"); fi

  local matches=false
  if content_matches "$src" "$cmp_dest"; then matches=true; fi

  if [[ "$matches" != true ]]; then
    warn "$item differs from repo version"
    local confirmed=false
    confirm_fn "Replace $item with repo version?" && confirmed=true
    if [[ "$confirmed" != true ]]; then return 1; fi
  fi

  if [[ -d "$dest" && ! -L "$dest" ]]; then rm -rf "$dest"; else rm -f "$dest"; fi
  mkdir -p "$(dirname "$dest")"
  ln -s "$src" "$dest"
  return 0
}

# ---------------------------------------------------------------------------
# Unfold stow directory symlinks: if a parent dir of dest is a symlink into
# our repo, replace it with a real dir and copy contents so we can manage
# individual file symlinks without corrupting the repo.
# ---------------------------------------------------------------------------
unfold_dir() {
  local dest="$1"
  local dir
  dir=$(dirname "$dest")
  if [[ -L "$dir" ]]; then
    local target
    target=$(readlink "$dir")
    # Only unfold if it points into our repo
    # Resolve relative targets
    if [[ "$target" != /* ]]; then
      target=$(cd "$(dirname "$dir")" && cd "$(dirname "$target")" && echo "$PWD/$(basename "$target")")
    fi
    if [[ "$target" == "$REPO_DIR"/* ]]; then
      rm "$dir"
      mkdir -p "$dir"
      cp -a "$target"/ "$dir"/
    fi
  fi
}

# ---------------------------------------------------------------------------
# Link a single item — auto-migrates existing non-ours files
# Returns: 0 = linked/already linked, 1 = user refused migration (abort)
# ---------------------------------------------------------------------------
link_item() {
  local item="$1"
  local src dest
  src=$(src_of "$item")
  dest=$(dest_of "$item")
  unfold_dir "$dest"
  is_ours "$dest" && return 0
  if [[ -e "$dest" || -L "$dest" ]]; then
    local rc=0
    migrate_item "$item" || rc=$?
    [[ $rc -eq 1 ]] && return 1
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  ln -s "$src" "$dest"
  return 0
}

# Unlink a single item — only removes our symlinks
unlink_item() {
  local item="$1"
  local dest
  dest=$(dest_of "$item")
  if is_ours "$dest"; then rm "$dest"; return 0; fi
  if [[ -e "$dest" ]]; then warn "Skip $item — not ours"; fi
  return 0
}

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

do_install_all() {
  local items count=0
  items=$(list_all)
  [[ -z "$items" ]] && error "No items found for $CLI"

  while read -r item; do
    local rc=0
    link_item "$item" || rc=$?
    if [[ $rc -eq 1 ]]; then
      info "Aborted by user."
      return 1
    fi
    is_ours "$(dest_of "$item")" && count=$((count + 1))
  done <<< "$items"

  info "Linked $count item(s) to ~/.$CLI/"
  return 0
}

do_install() {
  local items selected
  items=$(list_visible)
  [[ -z "$items" ]] && error "No items found for $CLI"

  local display
  display=$(list_display "$items")

  # Pre-select already installed items
  local preselected=()
  while read -r item; do
    if is_ours "$(dest_of "$item")"; then preselected+=("$item"); fi
  done <<< "$items"

  # Build pre-selected display lines
  local preselected_display=()
  if [[ ${#preselected[@]} -gt 0 ]]; then
    for p in "${preselected[@]}"; do
      local line
      line=$(echo "$display" | grep "^${p}$") || true
      if [[ -n "$line" ]]; then preselected_display+=("$line"); fi
    done
  fi

  local gum_args=(--no-limit --header "Select items to install:")
  if [[ ${#preselected_display[@]} -gt 0 ]]; then
    gum_args+=(--selected "$(IFS=,; echo "${preselected_display[*]}")")
  fi
  selected=$(echo "$display" | gum filter "${gum_args[@]}") || true

  if [[ -z "$selected" ]]; then warn "Nothing selected."; return 0; fi

  # Resolve agent deps + opencode commands→skills pairs
  local resolved=()
  while read -r line; do
    local item
    item=$(echo "$line" | strip_desc)
    resolved+=("$item")
    if [[ "$item" == agents/* ]]; then
      while read -r dep; do
        if [[ -n "$dep" ]]; then resolved+=("$dep"); fi
      done < <(deps_of "$item")
    elif [[ "$CLI" == "opencode" && "$item" == commands/* ]]; then
      local name="${item##*/}"
      if [[ -d "$REPO_DIR/$CLI/.$CLI/skills/$name" ]]; then resolved+=("skills/$name"); fi
    fi
  done <<< "$selected"

  # Deduplicate preserving order
  local seen="" unique=()
  for item in "${resolved[@]}"; do
    if [[ "$seen" != *"|$item|"* ]]; then
      seen="${seen}|$item|"
      unique+=("$item")
    fi
  done

  local count=0
  for item in "${unique[@]}"; do
    local rc=0
    link_item "$item" || rc=$?
    if [[ $rc -eq 1 ]]; then
      info "Aborted by user."
      return 0
    fi
    is_ours "$(dest_of "$item")" && count=$((count + 1))
  done

  info "Linked $count new item(s) to ~/.$CLI/"
}

do_uninstall() {
  local items installed=() count=0
  items=$(list_all)

  while read -r item; do
    if is_ours "$(dest_of "$item")"; then installed+=("$item"); fi
  done <<< "$items"

  if [[ ${#installed[@]} -eq 0 ]]; then warn "Nothing installed."; return 0; fi

  local installed_list
  installed_list=$(printf '%s\n' "${installed[@]}")
  local display
  display=$(list_display "$installed_list")

  local gum_args=(--no-limit --header "Select items to uninstall:")
  gum_args+=(--selected "$(echo "$display" | tr '\n' ',')")

  local selected
  selected=$(echo "$display" | gum filter "${gum_args[@]}") || true

  if [[ -z "$selected" ]]; then warn "Nothing selected."; return 0; fi

  while read -r line; do
    local item
    item=$(echo "$line" | strip_desc)
    local dest
    dest=$(dest_of "$item")
    if is_ours "$dest"; then rm "$dest" && count=$((count + 1)); fi
  done <<< "$selected"

  info "Removed $count item(s) from ~/.$CLI/"
}

# ---------------------------------------------------------------------------
# Main — only runs when script is executed directly (not sourced)
# ---------------------------------------------------------------------------
main() {
  echo "=== Skills Manager ==="
  echo ""
  check_gum

  CLI=$(gum choose --header "Select CLI:" "claude" "opencode") || true
  if [[ -z "$CLI" ]]; then exit 0; fi

  local action
  action=$(gum choose --header "Action:" "Install" "Install all" "Uninstall") || true
  if [[ -z "$action" ]]; then exit 0; fi

  case "$action" in
    Install)       do_install ;;
    "Install all") do_install_all ;;
    Uninstall)     do_uninstall ;;
  esac
}

# Only run main when executed, not when sourced
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main
fi
